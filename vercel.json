{
  "rewrites": [
    {
      "source": "/oracao",
      "destination": "/oracao/index.html"
    },
    {
      "source": "/oracao/",
      "destination": "/oracao/index.html"
    },
    {
      "source": "/oracao/(.*)",
      "destination": "/oracao/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|avif|gif|svg|ico|css|js|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
